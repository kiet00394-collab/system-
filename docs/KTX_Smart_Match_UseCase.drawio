        <!-- PHÂN HỆ 1: PHÂN HỆ SINH VIÊN (TOP BOX)      -->
        <!-- ========================================== -->
        <mxCell id="box_student" value="HỆ THỐNG KTX SMART MATCH — PHÂN HỆ SINH VIÊN (11 USE CASES)" style="shape=rect;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#0CA678;strokeWidth=2.5;fontStyle=1;fontSize=13;fontColor=#087F5B;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="35" width="900" height="440" as="geometry" />
        </mxCell>

        <!-- CỘT 1: TÀI KHOẢN, NẾP SỐNG & NỘP ĐƠN (x=240) -->
        <mxCell id="uc01" value="UC-01: Đăng nhập &amp; Xác thực hệ thống&#xa;(Tên/Email hoặc MSSV + Mật khẩu)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=1.5;fontStyle=1;fontSize=10.5;fontColor=#087F5B;" vertex="1" parent="1">
          <mxGeometry x="240" y="75" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc02" value="UC-02: Đăng ký tài khoản &amp;&#xa;Khai báo nếp sống 8 tiêu chí" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=1.5;fontStyle=1;fontSize=10.5;fontColor=#087F5B;" vertex="1" parent="1">
          <mxGeometry x="240" y="165" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc03" value="UC-03: Cập nhật hồ sơ &amp;&#xa;nếp sống sinh hoạt (hỗ trợ Persona)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=1.5;fontStyle=1;fontSize=10.5;fontColor=#087F5B;" vertex="1" parent="1">
          <mxGeometry x="240" y="255" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc04" value="UC-04: Chọn loại phòng &amp;&#xa;Nộp đơn KTX (cam kết ≥ 1 kỳ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=1.5;fontStyle=1;fontSize=10.5;fontColor=#087F5B;" vertex="1" parent="1">
          <mxGeometry x="240" y="345" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- CỘT 2: GHÉP BẠN HAI CHIỀU & PHÂN PHÒNG (x=530) -->
        <mxCell id="uc05a" value="UC-05A: Gửi yêu cầu ghép bạn&#xa;cùng phòng (Send Matching Request)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D3F9D8;strokeColor=#2B8A3E;strokeWidth=2;fontStyle=1;fontSize=10.5;fontColor=#2B8A3E;" vertex="1" parent="1">
          <mxGeometry x="530" y="75" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc05c" value="UC-05C: Xem chi tiết hồ sơ &amp;&#xa;đối sánh nếp sống (Radar 8 thói quen)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E7F5FF;strokeColor=#1C7ED6;strokeWidth=2;fontStyle=1;fontSize=10.5;fontColor=#1971C2;" vertex="1" parent="1">
          <mxGeometry x="530" y="165" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc05b" value="UC-05B: Phản hồi yêu cầu ghép bạn&#xa;(Chỉ Đồng ý/Từ chối &amp; Gửi KTX)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D3F9D8;strokeColor=#2B8A3E;strokeWidth=2;fontStyle=1;fontSize=10.5;fontColor=#2B8A3E;" vertex="1" parent="1">
          <mxGeometry x="530" y="255" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc06" value="UC-06: Xem kết quả phân phòng &amp;&#xa;Thông tin viện phí lưu trú" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=1.5;fontStyle=1;fontSize=10.5;fontColor=#087F5B;" vertex="1" parent="1">
          <mxGeometry x="530" y="345" width="260" height="65" as="geometry" />
        </mxCell>

